# build outputs
targets/*/.build/
targets/*/fuzz_*
!targets/*/fuzz_*.cpp
*.o
*.a

# libFuzzer artifacts
crash-*
leak-*
timeout-*
oom-*
*.profraw

# fuzzing corpus growth (seed corpus is tracked; runtime corpus is not)
corpus_run/

# EMBARGOED: live reproducers and undisclosed findings. Never push publicly.
PRIVATE_findings/

# cargo-fuzz build + runtime artifacts (artifacts/ holds live crash reproducers)
targets/*/fuzz/target/
targets/*/fuzz/corpus/
targets/*/fuzz/artifacts/
# EMBARGOED: patched dependency checkout used as a fuzz-blocker for an
# UNREPORTED bug. A blocker patch for an unreported finding is a disclosure
# artifact; keep it local until the finding is reported.
targets/*/.tokenizers-src/

# python bytecode
__pycache__/
*.pyc

# continuous-fuzz working corpus (accumulated, cached in CI, not committed)
targets/*/corpus_run/
targets/*/corpus_min/
